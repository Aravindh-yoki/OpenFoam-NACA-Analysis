FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

// k = 1.5 (I U)^2 ,  I = 1 %  ->  1.5e-4 m2/s2
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 1.5e-4;

boundaryField
{
    farfield
    {
        type            freestream;
        freestreamValue uniform 1.5e-4;
    }
    airfoil
    {
        type            kqRWallFunction;
        value           uniform 1.5e-4;
    }
    front { type empty; }
    back  { type empty; }
}
