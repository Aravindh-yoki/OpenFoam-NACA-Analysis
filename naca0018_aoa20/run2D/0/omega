FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}

// omega ~ 10 U / c  ~ 60 1/s  (nut/nu ~ 2.5 in the free stream)
dimensions      [0 0 -1 0 0 0 0];
internalField   uniform 60;

boundaryField
{
    farfield
    {
        type            freestream;
        freestreamValue uniform 60;
    }
    airfoil
    {
        type            omegaWallFunction;
        value           uniform 60;
    }
    front { type empty; }
    back  { type empty; }
}
