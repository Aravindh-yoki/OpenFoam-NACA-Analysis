FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

// Free-stream velocity U = 1 m/s along +x   <-- change to your speed
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (1 0 0);

boundaryField
{
    farfield
    {
        type            freestreamVelocity;
        freestreamValue uniform (1 0 0);
    }
    airfoil
    {
        type            noSlip;
    }
    front { type empty; }
    back  { type empty; }
}
