FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      extrudeMeshDict;
}

constructFrom   patch;
sourceCase      "../mesh3D";
sourcePatches   (front);
exposedPatchName back;

flipNormals     false;
extrudeModel    linearNormal;

nLayers         1;
expansionRatio  1.0;

linearNormalCoeffs
{
    nLayers         1;
    expansionRatio  1.0;
    thickness       0.01;
}

mergeFaces      false;
mergeTol        0;
