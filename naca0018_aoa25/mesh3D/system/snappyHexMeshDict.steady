FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    airfoil
    {
        type    triSurface;
        file    "airfoil.stl";
    }
    nearBox
    {
        type    box;
        min     (-0.03 -0.05 -1);
        max     ( 0.22  0.05  1);
    }
    wakeBox
    {
        type    box;
        min     (-0.10 -0.15 -1);
        max     ( 1.00  0.15  1);
    }
}

castellatedMeshControls
{
    maxLocalCells        10000000;
    maxGlobalCells       20000000;
    minRefinementCells   0;
    maxLoadUnbalance     0.10;
    nCellsBetweenLevels  3;

    features ();

    refinementSurfaces
    {
        airfoil
        {
            level (6 6);                     // 0.05 / 2^6 = 0.78 mm cells on the foil
            patchInfo { type wall; }
        }
    }

    resolveFeatureAngle  30;

    refinementRegions
    {
        nearBox { mode inside; level 5; }
        wakeBox { mode inside; level 4; }
    }

    // any point in the WATER (outside foil, inside the slab, not on a cell face)
    locationInMesh (-0.4123 0.3123 0.0043);

    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch        3;
    tolerance           2.0;
    nSolveIter          100;
    nRelaxIter          5;
    nFeatureSnapIter    10;
    implicitFeatureSnap true;
    explicitFeatureSnap false;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes       false;               // sizes below are in metres
    layers
    {
        airfoil { nSurfaceLayers 8; }
    }
    expansionRatio      1.25;
    firstLayerThickness 4e-5;                // y+ ~ 1 for U ~ 1 m/s  (see README)
    minThickness        1e-6;
    nGrow               0;
    featureAngle        130;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
    nRelaxedIter        20;
}

meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-13;
    minTetQuality       1e-15;
    minArea             -1;
    minTwist            0.02;
    minDeterminant      0.001;
    minFaceWeight       0.05;
    minVolRatio         0.01;
    minTriangleTwist    -1;
    nSmoothScale        4;
    errorReduction      0.75;
    relaxed { maxNonOrtho 75; }
}

mergeTolerance 1e-6;
