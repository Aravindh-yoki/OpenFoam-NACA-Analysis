FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

// kinematic pressure p/rho  [m2/s2]
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    farfield
    {
        type            freestreamPressure;
        freestreamValue uniform 0;
    }
    airfoil
    {
        type            zeroGradient;
    }
    front { type empty; }
    back  { type empty; }
}
